{
  "kind": "collectionType",
  "collectionName": "catalog_products",
  "info": {
    "singularName": "catalog-product",
    "pluralName": "catalog-products",
    "displayName": "CatalogProduct"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "productType": {
      "type": "enumeration",
      "enum": [
        "single",
        "bundle"
      ]
    },
    "description": {
      "type": "richtext"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isActive": {
      "type": "boolean"
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-variant.product-variant",
      "mappedBy": "product"
    },
    "bundle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::bundle.bundle",
      "mappedBy": "product"
    },
    "items": {
      "type": "component",
      "component": "our-products.what-on-component",
      "repeatable": true
    },
    "productList": {
      "type": "component",
      "component": "shared.item-list",
      "repeatable": true
    },
    "limitedEdition": {
      "type": "boolean"
    },
    "bestSellers": {
      "type": "boolean"
    },
    "rating": {
      "type": "decimal"
    },
    "ratingCount": {
      "type": "integer"
    },
    "heroAccordions": {
      "type": "component",
      "component": "product.accordion-section",
      "repeatable": true
    },
    "applicationSteps": {
      "type": "component",
      "component": "product.application-step",
      "repeatable": true
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos", "files"]
    },
    "videoThumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "videoOverlayText": {
      "type": "string"
    },
    "videoSubText": {
      "type": "string"
    },
    "prepSteps": {
      "type": "component",
      "component": "product.prep-step",
      "repeatable": true
    },
    "prepStepsTitle": {
      "type": "string"
    },
    "prepStepsImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "applicationStepsDetailed": {
      "type": "component",
      "component": "product.detailed-step",
      "repeatable": true
    },
    "applicationTitle": {
      "type": "string"
    },
    "applicationImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "ingredientsImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "ingredientsTitle": {
      "type": "string"
    },
    "fullIngredientsList": {
      "type": "text"
    },
    "results": {
      "type": "component",
      "component": "product.result-tab",
      "repeatable": true
    },
    "routineSteps": {
      "type": "component",
      "component": "product.routine-step",
      "repeatable": true
    },
    "faqs": {
      "type": "component",
      "component": "contact.faq-item",
      "repeatable": true
    },
    "faqImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "faqTitle": {
      "type": "string"
    },
    "faqSubtitle": {
      "type": "string"
    },
    "fullRoutineTitle": {
      "type": "string"
    },
    "fullRoutineSubtitle": {
      "type": "string"
    },
    "fullRoutineSteps": {
      "type": "component",
      "component": "product.full-routine-step",
      "repeatable": true
    }
  }
}
